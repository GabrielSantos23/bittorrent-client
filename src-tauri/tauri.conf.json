{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitTorrent Client",
  "version": "0.1.0",
  "identifier": "com.btcore.desktop",
  "build": {
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "ui"
    },
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BitTorrent Client",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
