{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitTorrent Client",
  "version": "1.0.0",
  "identifier": "com.btcore.desktop",
  "build": {
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "ui"
    },
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BitTorrent Client",
        "width": 1360,
        "height": 760,
        "minWidth": 1280,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2NjM1N0I5NTVGREEzOUQKUldTZG8vMVZ1VmRqZHNPTWdWVXJJYWxTZ2lsSHlPOTJXSUo4ZXVUVnVvZk9hT3MxMkN2bDJ2VVoK",
      "endpoints": [
        "https://github.com/GabrielSantos23/bittorrent-client/releases/latest/download/latest.json"
      ]
    }
  }
}
